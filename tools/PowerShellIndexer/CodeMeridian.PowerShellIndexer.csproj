<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CodeMeridian.PowerShellIndexer</RootNamespace>
    <AssemblyName>CodeMeridian.PowerShellIndexer</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/CodeMeridian.Core.csproj" />
    <PackageReference Include="System.Management.Automation" Version="[7.6.8]" />
  </ItemGroup>
</Project>
